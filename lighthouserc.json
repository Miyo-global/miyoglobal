{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3111/",
        "http://localhost:3111/staffing-solutions",
        "http://localhost:3111/digital-solutions",
        "http://localhost:3111/case-studies",
        "http://localhost:3111/about",
        "http://localhost:3111/contact",
        "http://localhost:3111/jobs",
        "http://localhost:3111/referrals",
        "http://localhost:3111/blog"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }]
      }
    }
  }
}
